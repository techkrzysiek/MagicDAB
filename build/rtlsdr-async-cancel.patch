librtlsdr 2.0.3: rtlsdr_read_async freed transfers still in flight

When streaming is cancelled, a transfer can complete normally and be
resubmitted by the callback, or its cancellation can complete after
rtlsdr_read_async has already freed the buffers. libusb then uses freed
memory when the transfer returns: on Windows the program crashed in
windows_submit_transfer (rtlsdr.dll) or ntdll when the stick was closed.

- no resubmit once canceling;
- a count of the transfers in flight, waited for (2 s at most) before
  the buffers are freed; ones still out after that are not freed.

--- a/src/librtlsdr.c	2026-11-13 00:31:57.765547168 +0100
+++ b/src/librtlsdr.c	2026-11-13 00:31:57.773547028 +0100
@@ -119,6 +119,8 @@
 	int dev_lost;
 	int driver_active;
 	unsigned int xfer_errors;
+	/* transfers submitted and not back yet: never freed while in flight */
+	int xfer_inflight;
 	char manufact[256];
 	char product[256];
 };
@@ -1726,8 +1728,12 @@
 		if (dev->cb)
 			dev->cb(xfer->buffer, xfer->actual_length, dev->cb_ctx);
 
-		libusb_submit_transfer(xfer); /* resubmit transfer */
 		dev->xfer_errors = 0;
+		/* resubmit transfer, unless canceling: it would still be in
+		 * flight when rtlsdr_read_async frees it */
+		if (RTLSDR_RUNNING == dev->async_status &&
+		    0 == libusb_submit_transfer(xfer))
+			return;
 	} else if (LIBUSB_TRANSFER_CANCELLED != xfer->status) {
 #ifndef _WIN32
 		if (LIBUSB_TRANSFER_ERROR == xfer->status)
@@ -1743,6 +1749,7 @@
 		}
 #endif
 	}
+	dev->xfer_inflight--;
 }
 
 int rtlsdr_wait_async(rtlsdr_dev_t *dev, rtlsdr_read_async_cb_t cb, void *ctx)
@@ -1835,6 +1842,17 @@
 	if (!dev)
 		return -1;
 
+	/* still in flight after rtlsdr_read_async waited for them (a lost
+	 * device): libusb would use them when they return, so they are left */
+	if (dev->xfer_inflight > 0) {
+		fprintf(stderr, "%d transfers still in flight, not freed\n",
+			dev->xfer_inflight);
+		dev->xfer = NULL;
+		dev->xfer_buf = NULL;
+		dev->xfer_inflight = 0;
+		return 0;
+	}
+
 	if (dev->xfer) {
 		for(i = 0; i < dev->xfer_buf_num; ++i) {
 			if (dev->xfer[i]) {
@@ -1900,6 +1918,7 @@
 		dev->xfer_buf_len = DEFAULT_BUF_LENGTH;
 
 	_rtlsdr_alloc_async_buffers(dev);
+	dev->xfer_inflight = 0;
 
 	for(i = 0; i < dev->xfer_buf_num; ++i) {
 		libusb_fill_bulk_transfer(dev->xfer[i],
@@ -1912,6 +1931,8 @@
 					  BULK_TIMEOUT);
 
 		r = libusb_submit_transfer(dev->xfer[i]);
+		if (r == 0)
+			dev->xfer_inflight++;
 		if (r < 0) {
 			fprintf(stderr, "Failed to submit transfer %i\n"
 					"Please increase your allowed " 
@@ -1973,6 +1994,15 @@
 				 * just cancelled all transfers */
 				libusb_handle_events_timeout_completed(dev->ctx,
 								       &zerotv, NULL);
+				/* a cancelled transfer can still be on its way
+				 * back (on Windows the cancel completes later):
+				 * freed now, libusb would touch freed memory when
+				 * it returns. Wait for all of them, 2 s at most. */
+				for (i = 0; dev->xfer_inflight > 0 && i < 20; ++i) {
+					struct timeval waittv = { 0, 100000 };
+					libusb_handle_events_timeout_completed(dev->ctx,
+									       &waittv, NULL);
+				}
 				break;
 			}
 		}
