+/* Android: a device the app opened (UsbManager), by its file descriptor */
+static intptr_t open_sys_dev = -1;
+
+int rtlsdr_open(rtlsdr_dev_t **out_dev, uint32_t index);
+
+int rtlsdr_open_fd(rtlsdr_dev_t **out_dev, int fd)
+{
+	int r;
+	open_sys_dev = fd;
+	r = rtlsdr_open(out_dev, 0);
+	open_sys_dev = -1;
+	return r;
+}
